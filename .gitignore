# ==============================================================================
# SEGURANÇA - Arquivos sensíveis e credenciais
# ==============================================================================
# Chaves privadas (NUNCA commitar)
*.pem
*.key
*.p12
*.jks
!public.pem  # Exceção: chave pública PODE ser commitada

# Arquivos de ambiente com secrets reais
.env
.env.local
.env.*.local

# Credentials e tokens
*credentials*
*secrets*
*.secret

